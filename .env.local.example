# Optional: the shared project's publishable read-only defaults are already configured.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# For offline tests only; production uses shared data.
# NOTICE_DATA_MODE=local

# Optional administrator-only manual sync; never prefix these with NEXT_PUBLIC_.
# SYNC_ADMIN_TOKEN=<generate-a-long-random-token>
# SUPABASE_SECRET_KEY=sb_secret_...
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Optional server-only address geocoding; existing source coordinates need no key.
# GEOAPIFY_API_KEY=your-server-key
