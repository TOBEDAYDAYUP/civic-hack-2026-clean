{
  "name": "your-city-council-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ollama:setup": "bash scripts/setup-ollama.sh",
    "data:update": "node scripts/update-notices.mjs --limit=3",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "npm run format:check && npm run test:sync && npm run test:browse && npm run test:map && npm run test:setup && npm run test:impact && npm run typecheck && npm run build && npm run test:smoke",
    "format": "prettier --write components features app/notices scripts/smoke-test.mjs",
    "format:check": "prettier --check components features app/notices scripts/smoke-test.mjs",
    "data:sync": "node --env-file=.env.local scripts/sync-notices.mjs",
    "test:sync": "node --test tests/sync.test.mjs",
    "test:browse": "node --test tests/notice-browser.test.mjs",
    "titles:shorten": "node --env-file=.env.local scripts/shorten-titles.mjs",
    "test:map": "node --test tests/map-regions.test.mjs tests/map-geocode.test.mjs",
    "setup": "node scripts/setup-env.mjs",
    "predev": "node scripts/setup-env.mjs",
    "prebuild": "node scripts/setup-env.mjs",
    "test:setup": "node --test tests/setup-env.test.mjs",
    "test:impact": "node --test tests/impact.test.mjs tests/impact-publish.test.mjs tests/notice-ai-worker.test.mjs",
    "data:analyze": "node --env-file=.env.local scripts/summarize-notices.mjs",
    "data:watch": "node --env-file=.env.local scripts/watch-notice-ai.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.10.1",
    "supabase": "2.122.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22 <27"
  }
}
